# Servidor
PORT=3002
NODE_ENV=production

# JWT interno (sessão do sistema)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Host do Portal Único (sem /ccta). Produção: https://portalunico.siscomex.gov.br
# Homologação/TRE: https://val.portalunico.siscomex.gov.br
BASE_URL=https://portalunico.siscomex.gov.br

# Autenticação Portal Único — Role-Type = código do manual (Transportador → TRANSPORT)
SISCOMEX_AUTH_PATH=/portal/api/autenticar
SISCOMEX_ROLE_TYPE=TRANSPORT

# CCT — GET /api/ext/conhecimentos (Swagger: numeroConhecimento obrigatório)
SISCOMEX_MAWB_PATH=/ccta/api/ext/conhecimentos/resumo
SISCOMEX_HAWB_PATH=/ccta/api/ext/conhecimentos/resumo
SISCOMEX_MAWB_METHOD=GET
SISCOMEX_HAWB_METHOD=GET
SISCOMEX_NUMERO_PARAM=numeroConhecimento
SISCOMEX_REQUEST_TIMEOUT_MS=60000
SISCOMEX_JWT_REFRESH_MARGIN_SEC=120
SISCOMEX_STATUS_RECEPCIONADA=RECEPCIONADA

# Domínio do frontend em produção (usado pelo CORS). Front e back são deploys
# separados no EasyPanel — informe a URL completa do frontend, sem barra no final.
# Ex.: https://cct-app.seudominio.easypanel.host
CORS_ORIGIN=

# Banco de dados Postgres (EasyPanel)
DATABASE_URL=

# Chave de criptografia do certificado/chave de acesso salvos no banco.
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CERT_ENCRYPTION_KEY=

# SMTP para envio de e-mail da automação de fila
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CCT Notificações <notificacoes@seudominio.com>"

# Polling da fila de consultas (padrão: a cada 10 min) e limite de falhas seguidas
FILA_POLL_CRON="*/10 * * * *"
FILA_MAX_TENTATIVAS_ERRO=20
